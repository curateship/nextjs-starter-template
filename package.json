{
  "name": "system-everything",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "services/*"],
  "scripts": {
    "dev": "turbo dev",
    "dev:custom-shell": "npm run dev:custom-shell-ui",
    "dev:custom-shell-ui": "npm run dev --workspace=custom-shell",
    "dev:ai-video": "npm run dev --workspace=ai-video",
    "dev:core": "npm run dev --workspace=core",
    "dev:anti-detect": "npm run dev --workspace=anti-detect",
    "dev:pomoder": "npm run dev --workspace=pomoder",
    "dev:ai-agents": "npm run dev --workspace=ai-agents",
    "dev:personal-ide": "npm run tauri:dev --workspace=personal-ide",
    "dev:hub": "npm run dev --workspace=@repo/hub",
    "dev:directory": "npm run dev --workspace=directory",
    "build": "turbo build",
    "build:custom-shell": "npm run build --workspace=custom-shell",
    "build:ai-video": "npm run build --workspace=ai-video",
    "build:core": "npm run build --workspace=core",
    "build:anti-detect": "npm run build --workspace=anti-detect",
    "build:pomoder": "npm run build --workspace=pomoder",
    "build:ai-agents": "npm run build --workspace=ai-agents",
    "build:personal-ide": "npm run tauri:build --workspace=personal-ide",
    "build:directory": "npm run build --workspace=directory",
    "lint": "turbo lint"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "postcss": "8.5.12"
  },
  "devDependencies": {
    "turbo": "^2",
    "vite": "^8.0.16"
  }
}
