{
  "name": "system-everything",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "services/*"],
  "scripts": {
    "dev": "turbo dev",
    "dev:custom-shell": "pnpm run dev:custom-shell-ui",
    "dev:custom-shell-ui": "pnpm --filter custom-shell dev",
    "dev:ai-video": "pnpm --filter ai-video dev",
    "dev:core": "pnpm --filter core dev",
    "dev:anti-detect": "pnpm --filter anti-detect dev",
    "dev:pomoder": "pnpm --filter pomoder dev",
    "dev:ai-agents": "pnpm --filter ai-agents dev",
    "dev:personal-ide": "pnpm --filter personal-ide tauri:dev",
    "dev:hub": "pnpm --filter @repo/hub dev",
    "dev:directory": "pnpm --filter directory dev",
    "build": "turbo build",
    "build:custom-shell": "pnpm --filter custom-shell build",
    "build:ai-video": "pnpm --filter ai-video build",
    "build:core": "pnpm --filter core build",
    "build:anti-detect": "pnpm --filter anti-detect build",
    "build:pomoder": "pnpm --filter pomoder build",
    "build:ai-agents": "pnpm --filter ai-agents build",
    "build:personal-ide": "pnpm --filter personal-ide tauri:build",
    "build:directory": "pnpm --filter directory build",
    "lint": "turbo lint"
  },
  "packageManager": "pnpm@11.15.0",
  "overrides": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "postcss": "8.5.12"
  },
  "devDependencies": {
    "turbo": "^2",
    "vite": "^8.0.16"
  }
}
