{
  "name": "system-everything",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "services/*"],
  "scripts": {
    "dev": "turbo dev",
    "dev:custom-shell": "npm run dev --workspace=custom-shell",
    "dev:hub": "npm run dev --workspace=@repo/hub",
    "dev:scraper": "npm run dev --workspace=@repo/scraper",
    "dev:scraper-api": "cd services/scraper-api && uvicorn app.main:app --reload --port 8001",
    "dev:seo": "npm run dev --workspace=@repo/seo",
    "dev:seo-api": "cd services/seo-api && uvicorn app.main:app --reload",
    "build": "turbo build",
    "build:custom-shell": "npm run build --workspace=custom-shell",
    "build:seo": "npm run build --workspace=@repo/seo",
    "lint": "turbo lint"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "postcss": "8.5.12"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
