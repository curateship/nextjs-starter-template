# Copy to .env and fill in. Phase 0 needs a REAL proxy (residential/mobile ideal)
# for a meaningful stealth result — without one you're testing the datacenter IP
# of wherever Docker runs, which most detectors flag instantly.

# Proxy in Playwright format. Scheme can be http:// or socks5://.
PROXY_SERVER=http://your-proxy-host:port
PROXY_USERNAME=your-user
PROXY_PASSWORD=your-pass

# Fingerprint OS seed for Camoufox (windows | macos | linux). The rest of the
# fingerprint is auto-generated consistently by BrowserForge.
FP_OS=windows

# Where the browser lands on launch. Default is the CreepJS stealth test.
START_URL=https://abrahamjuliot.github.io/creepjs/
