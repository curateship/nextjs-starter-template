# Development only
SHADCNBLOCKS_API_KEY=""

ANTIDETECT_R2_ACCOUNT_ID=""
ANTIDETECT_R2_ACCESS_KEY_ID=""
ANTIDETECT_R2_SECRET_ACCESS_KEY=""
ANTIDETECT_R2_BUCKET_NAME="custom-shell-media"
ANTIDETECT_R2_PUBLIC_URL=""

# AES-256-GCM key for encrypting stored secrets (proxy passwords). Generate: openssl rand -hex 32
ANTIDETECT_ENCRYPTION_KEY=""

# Browser sessions bind to loopback by default. Set only behind trusted network controls.
ANTIDETECT_STREAM_BIND_HOST="127.0.0.1"

# Static Neko credentials for browser streams.
ANTIDETECT_NEKO_USER_PASSWORD="neko"
ANTIDETECT_NEKO_ADMIN_PASSWORD="admin"
