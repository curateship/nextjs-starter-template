# Database (local dev default matches docker-compose.yml)
AI_AGENTS_DATABASE_URL="postgresql://postgres:localdev@localhost:54323/ai_agents"

# Voice provider (Vapi) — required from Phase 3 onward
AI_AGENTS_VAPI_API_KEY=""
# Optional: verified on inbound webhooks when set
AI_AGENTS_VAPI_WEBHOOK_SECRET=""
# Prod only: public base URL; enables webhook serverUrl on synced assistants
AI_AGENTS_PUBLIC_URL=""

# Campaign dialer
AI_AGENTS_MAX_CONCURRENT_CALLS="5"
# Default country for normalizing 10-digit phone numbers on CSV import
AI_AGENTS_DEFAULT_COUNTRY="US"

# App origins allowed for mutating server functions
AI_AGENTS_APP_ORIGINS="http://localhost:3006"

# Media storage (Cloudflare R2) — unused for MVP, recordings use Vapi URLs
AI_AGENTS_R2_ACCOUNT_ID=""
AI_AGENTS_R2_ACCESS_KEY_ID=""
AI_AGENTS_R2_SECRET_ACCESS_KEY=""
AI_AGENTS_R2_BUCKET_NAME="ai-agents-media"
AI_AGENTS_R2_PUBLIC_URL=""

# Development only (shadcn blocks CLI)
SHADCNBLOCKS_API_KEY=""
