<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain http is allowed so the phone can reach the local dev server on the same
  Wi-Fi, such as http://192.168.1.20:3023. Every message is still signed with
  the phone's key, and the app's screen warns when the address is not https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
