# Shared Hub database and auth
DATABASE_URL=""
AUTH_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
BETTER_AUTH_TRUSTED_ORIGINS=""
INTEGRATION_ENCRYPTION_KEY=""

# Public Vite configuration.
# These two are frozen into the bundle at build time. In production they must be
# passed to `docker build` as build arguments; setting them only at runtime has
# no effect. VITE_APP_URL is the app's own origin (https://host) and
# VITE_APP_DOMAIN is the base domain tenant subdomains hang off.
VITE_APP_URL=""
VITE_APP_DOMAIN=""
HUB_PLATFORM_HOST=""

# Custom-domain wiring (production only). Saving a custom domain writes a Traefik
# route pointing at the deployed app's service and attaches the domain to the
# Coolify application, so these must name the application that is actually
# serving Directory.
COOLIFY_BASE_URL=""
COOLIFY_API_TOKEN=""
COOLIFY_HUB_APP_UUID=""
TRAEFIK_HUB_SERVICE=""
TRAEFIK_DYNAMIC_CONFIG_DIR=""
TRAEFIK_DYNAMIC_CONFIG_ENDPOINT=""
TRAEFIK_DYNAMIC_CONFIG_TOKEN=""

# Optional email and media integrations
AUTH_FROM_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Google sign-in (optional). Set both to enable "Continue with Google" on the
# login block. One platform-level Google OAuth app is shared by every tenant:
# register a single redirect URI of <OAUTH_PROXY_PRODUCTION_URL>/api/auth/callback/google
# in Google Cloud Console. The OAuth proxy bounces the signed session back to
# whichever tenant host started the flow. OAUTH_PROXY_PRODUCTION_URL defaults to
# BETTER_AUTH_URL, then the Hub platform origin.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_PROXY_PRODUCTION_URL=""
# Optional in development; when these credentials are omitted, media is stored in .local-storage/.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="site-media"
R2_PUBLIC_URL=""

# Optional protected endpoints and integrations
CRON_SECRET=""
HUB_CORE_BRIDGE_TOKEN=""
HUB_CORE_BRIDGE_SITE_IDS=""
TRUSTED_CLIENT_IP_HEADER=""
