# Development only
SHADCNBLOCKS_API_KEY=""

CUSTOM_SHELL_R2_ACCOUNT_ID=""
CUSTOM_SHELL_R2_ACCESS_KEY_ID=""
CUSTOM_SHELL_R2_SECRET_ACCESS_KEY=""
CUSTOM_SHELL_R2_BUCKET_NAME="custom-shell-media"
CUSTOM_SHELL_R2_PUBLIC_URL=""

# Absolute base URL used in email links and Stripe redirects. Leave empty in
# local development: it falls back to this app's port in local-apps.json.
CUSTOM_SHELL_APP_URL=""

# Email (Resend). With no key, development logs verification and password reset
# links to the server console instead of sending them.
CUSTOM_SHELL_RESEND_API_KEY=""
CUSTOM_SHELL_EMAIL_FROM="Custom Shell <onboarding@resend.dev>"

# Bot protection (Cloudflare Turnstile) on sign-up and forgotten-password.
# WITH EITHER OF THESE EMPTY THE CHECK IS SWITCHED OFF ENTIRELY. That is the
# point in local development and a hole in production — set both there.
# Cloudflare's documented always-passes test pair, for local trials:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
CUSTOM_SHELL_TURNSTILE_SITE_KEY=""
CUSTOM_SHELL_TURNSTILE_SECRET_KEY=""

# Billing. Stripe price ids live on the plan rows in the database, not here.
# Local webhooks: stripe listen --forward-to localhost:<port>/api/webhooks/stripe
CUSTOM_SHELL_BILLING_ENABLED="false"
CUSTOM_SHELL_STRIPE_SECRET_KEY=""
CUSTOM_SHELL_STRIPE_WEBHOOK_SECRET=""
