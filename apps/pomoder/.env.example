# App
# Optional production origins. Local origins derive from `local-apps.json`.
POMODER_APP_URL=""
POMODER_ALLOWED_ORIGINS=""
POMODER_DATABASE_URL="postgresql://postgres:localdev@localhost:54326/pomoder"
POMODER_POSTGRES_PORT="54326"
POMODER_PGPOOL_MAX="10"
# One-time `npm run admin:create` inputs; remove the password after use.
POMODER_ADMIN_EMAIL=""
POMODER_ADMIN_NAME="Admin"
POMODER_ADMIN_PASSWORD=""

# Email
RESEND_API_KEY=""
POMODER_EMAIL_FROM="Pomoder <hello@example.com>"

# Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""

# Storage
POMODER_R2_ACCOUNT_ID=""
POMODER_R2_ACCESS_KEY_ID=""
POMODER_R2_SECRET_ACCESS_KEY=""
POMODER_R2_BUCKET_NAME="pomoder-media"

# AI and monitoring
GEMINI_API_KEY=""
POMODER_GEMINI_VIDEO_MODEL="veo-3.1-lite-generate-preview"
ELEVENLABS_API_KEY=""
SENTRY_DSN=""
VITE_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
POMODER_METRICS_TOKEN=""
POMODER_REQUIRE_WORKER="false"

# Feature gates
POMODER_BILLING_ENABLED="false"
POMODER_ROOMS_ENABLED="false"
POMODER_AI_ENABLED="false"
