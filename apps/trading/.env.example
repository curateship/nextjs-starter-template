# Development only
SHADCNBLOCKS_API_KEY=""

CUSTOM_SHELL_R2_ACCOUNT_ID=""
CUSTOM_SHELL_R2_ACCESS_KEY_ID=""
CUSTOM_SHELL_R2_SECRET_ACCESS_KEY=""
CUSTOM_SHELL_R2_BUCKET_NAME="custom-shell-media"
CUSTOM_SHELL_R2_PUBLIC_URL=""

# Trading
# 32-byte base64 master key for wallet private key encryption.
# Generate with: openssl rand -base64 32
# Required by BOTH the web app and the worker (they read the same .env.local).
TRADING_MASTER_KEY=""
# Default Hyperliquid network (testnet | mainnet). Mainnet also requires
# TRADING_ENABLE_MAINNET=true; it is disabled otherwise.
HL_NETWORK="testnet"
# The hard gate for real-money trading. Deliberate two-step to go live:
#   1. Run the full testnet E2E checklist (workspace/docs/Key-Features/wallet-onboarding.md)
#      with a funded testnet wallet: connect flow, manual place/cancel, a small
#      live bot, and the worker-restart reconcile test.
#   2. Only then set this to "true" for BOTH the web app and the worker, and
#      restart both. Pause all mainnet bots BEFORE ever flipping it back off —
#      the worker's network gate fails mid-run otherwise.
TRADING_ENABLE_MAINNET="false"
# Manual-trading risk limits. Code defaults (100000 / 25 / 100) are
# testnet-loose; set conservative values before enabling mainnet, e.g.:
# TRADING_MAX_POSITION_NOTIONAL_USD="1000"
# TRADING_MAX_LEVERAGE="3"
# TRADING_MAX_OPEN_ORDERS="20"
