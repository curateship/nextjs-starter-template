{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "preserve",
    "erasableSyntaxOnly": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "../src/server", "../src/lib/strategies"],
  "exclude": ["src/**/*.test.ts", "../src/**/*.test.ts", "../src/**/*.test.tsx"]
}
